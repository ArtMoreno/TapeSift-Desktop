# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 79

[*.{md,txt}]
trim_trailing_whitespace = false

[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,ico,ttf,otf,woff,woff2,mp4,mov,exe,dll}]
insert_final_newline = false
trim_trailing_whitespace = false
